# Normalise line endings in this repository, while each machine keeps its own.
# This file is the repository's own: it sat in a monorepo until 2026-09-11, whose copy never
# travelled with the exported folder, and now there is nothing above it to inherit from at all.

* text=auto

*.xml   text
*.md    text
*.txt   text

*.png binary
*.psd binary

# The pass maps are read by a bash script in the WSL: a carriage return would end up inside the
# Workshop id or the path, and the staging would look for a mod that does not exist.
*.map   text eol=lf
