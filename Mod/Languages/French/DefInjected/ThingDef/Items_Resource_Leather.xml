<?xml version="1.0" encoding="utf-8" ?>
<LanguageData>

  <!-- EN: dalmatian leather -->
  <!-- "cuir de", as the English source says leather (owner review, 2026-10-02); vanilla's own French
       "fourrure de chien" is not followed. -->
  <Leather_Dalmatian.label>cuir de dalmatien</Leather_Dalmatian.label>
  <!-- EN: Leather from cute dalmatians. You monster. -->
  <Leather_Dalmatian.description>Cuir de mignons dalmatiens. Vous êtes un monstre.</Leather_Dalmatian.description>
  <!-- The English def declares no stuffAdjective and falls back to the label, which reads
       correctly there. French needs the short form, exactly as vanilla injects one for every
       leather it ships. -->
  <Leather_Dalmatian.stuffProps.stuffAdjective>cuir de dalmatien</Leather_Dalmatian.stuffProps.stuffAdjective>

</LanguageData>
